# ---------------------------------------------------------------------------
# Website environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any real secret.
# ---------------------------------------------------------------------------

# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public / publishable (anon) key. Safe for the browser: access is limited by
# Row Level Security policies. This is NOT the service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLIC-ANON-KEY

# The device UUID the dashboard controls by default. This is the `devices.id`
# seeded by the migration, NOT the hardware_id string.
NEXT_PUBLIC_DEFAULT_DEVICE_ID=00000000-0000-0000-0000-000000000002

# ---------------------------------------------------------------------------
# Server-only secrets (used by API routes / Edge Functions). Never expose these
# to the browser and never commit them.
# ---------------------------------------------------------------------------

# AI assistant provider key (server-side only).
AI_API_KEY=

# AI model identifier for the assistant route.
AI_MODEL=gpt-4o-mini

# Optional: OpenAI-compatible base URL (change for another provider/gateway).
AI_BASE_URL=https://api.openai.com/v1

# Optional: service-role key ONLY for trusted server-side jobs. Leave empty in
# the browser app; privileged writes should go through Edge Functions / RLS.
SUPABASE_SERVICE_ROLE_KEY=
